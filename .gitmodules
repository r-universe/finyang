	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "RRRR"]
	path = RRRR
	url = https://github.com/finyang/rrrr
[submodule "flap"]
	path = flap
	url = https://github.com/finyang/flap
[submodule "roam"]
	path = roam
	url = https://github.com/finyang/roam
